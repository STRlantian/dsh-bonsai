{
    "name":  "dsh-bonsai",
    "version":  "0.1.3-test.0",
    "description":  "Bonsai (闂傚倸鍊搁崐鐑芥嚄閸洖纾块柣銏㈩焾閻ょ偓绻涢幋鐑嗙劯婵炴垶菤閺嬪酣鏌熼悙顒佺稇濞?: weighted conversation-tree memory, branch editing and reflection backtracking for DeepSeek Harness",
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "default":  "./dist/index.js"
                          },
                    "./core":  {
                                   "types":  "./dist/core/index.d.ts",
                                   "default":  "./dist/core/index.js"
                               },
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "dist",
                  "lib",
                  "cordis",
                  "docs/*.md",
                  "docs/experiments/*.json",
                  "docs/ui-mockup.html",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "typecheck":  "node scripts/build.mjs --noEmit",
                    "test":  "node --test \"tests/*.test.ts\"",
                    "check":  "node scripts/build.mjs --noEmit \u0026\u0026 node --test \"tests/*.test.ts\"",
                    "prepublishOnly":  "node scripts/build.mjs \u0026\u0026 node scripts/stage.mjs \u0026\u0026 node --test \"tests/*.test.ts\"",
                    "version:test":  "node scripts/bump-test-version.mjs"
                },
    "devDependencies":  {
                            "@types/node":  "^22.20.1",
                            "jsdom":  "^30.1.3",
                            "react":  "^19.3.1",
                            "react-dom":  "^19.3.1",
                            "typescript":  "^6.0.3"
                        },
    "engines":  {
                    "node":  "\u003e=24"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis/bundle.patch.yml"
                           },
                "client":  {
                               "platform":  "web"
                           }
            },
    "license":  "MIT",
    "author":  {
                   "name":  "STRlantian",
                   "email":  "m1606977882@outlook.com",
                   "url":  "https://github.com/STRlantian"
               },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/STRlantian/dsh-bonsai.git"
                   },
    "homepage":  "https://github.com/STRlantian/dsh-bonsai#readme",
    "bugs":  {
                 "url":  "https://github.com/STRlantian/dsh-bonsai/issues"
             },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "cordis-plugin",
                     "conversation-tree",
                     "context-management",
                     "token-budget",
                     "memory",
                     "branching"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      }
}
